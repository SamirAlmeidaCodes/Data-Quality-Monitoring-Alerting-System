# Copy this file to .env and replace the dummy values.
# .env is gitignored. Do not put real secrets in YAML, Docker files, or source code.
# The process reads these names from the environment. It does not open .env itself.
#
# Locally:
#   set -a
#   source .env
#   set +a
# Docker Compose loads .env into the container when the file exists.

# DQ_ENV=production
# DQ_CONFIG=config/rules.yaml
# DQ_DATABASE_URL=sqlite:///data/monitor.db
# LOG_LEVEL=INFO
# HOST=127.0.0.1
# PORT=8000

# SMTP password used when alerting.email.username is set.
DQ_SMTP_PASSWORD=replace-with-smtp-password

# Bearer token used when alerting.webhook.bearer_token_env is DQ_WEBHOOK_TOKEN.
DQ_WEBHOOK_TOKEN=replace-with-webhook-token
